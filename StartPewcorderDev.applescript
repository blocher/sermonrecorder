(*
PROJECT-LAUNCHER-SPEC v1: generated by Project Launcher (https://github.com/blocher/projectlauncher).
Edit this spec and regenerate (`launcher.py regenerate` on this file, or Regenerate in Project Launcher);
hand edits to the script below are overwritten when it's regenerated.
{
  "spec": 1,
  "id": "pewcorder",
  "name": "Pewcorder",
  "launcher": "StartPewcorderDev",
  "url": "http://localhost:{port:Frontend}/",
  "requires": [
    "npm",
    "redis-server"
  ],
  "setup": [
    "source {root}/backend/.venv/bin/activate"
  ],
  "panes": [
    {
      "role": "Redis",
      "port": 6382,
      "command": "redis-server --port {port}"
    },
    {
      "role": "Backend",
      "note": "Django API",
      "dir": "backend",
      "port": 8005,
      "command": "python manage.py runserver 127.0.0.1:{port}"
    },
    {
      "role": "Celery",
      "note": "Worker and beat, combined for local dev",
      "dir": "backend",
      "waitFor": [
        "Redis"
      ],
      "command": "celery -A config worker --beat --loglevel=INFO"
    },
    {
      "role": "Frontend",
      "note": "Vite frontend",
      "dir": "frontend",
      "port": 5175,
      "command": "npm run dev -- --port {port}"
    },
    {
      "role": "Working",
      "command": "git status"
    }
  ]
}
END-PROJECT-LAUNCHER-SPEC
*)

-- Pewcorder development environment: one iTerm window, one stacked pane per service.
property projectID : "pewcorder"

on run
	-- The repo is the folder holding this launcher, so it works in any clone or fork.
	set projectRoot to do shell script "dirname " & quoted form of (POSIX path of (path to me))

	if not iTermInstalled() then
		display alert "iTerm2 is required" message "Install it from https://iterm2.com, then run this launcher again."
		return
	end if
	set missingTools to loginShell(projectRoot, "for t in 'npm' 'redis-server'; do command -v \"$t\" >/dev/null || printf \"%s \" \"$t\"; done")
	if missingTools is not "" then
		display alert ("Pewcorder needs " & missingTools) message "Install the missing tools (they must be on your login shell's PATH), then run this launcher again."
		return
	end if

	tell application "Finder" to set screenBounds to bounds of window of desktop

	tell application "iTerm"
		activate
		-- Rerunning replaces this project's window; other iTerm windows are untouched.
		repeat with existingWindow in windows
			try
				repeat with existingSession in sessions of current tab of existingWindow
					tell existingSession to set existingTag to variable named "user.launcherProject"
					if existingTag is my projectID then
						close existingWindow
						exit repeat
					end if
				end repeat
			end try
		end repeat

		set devWindow to (create window with default profile)
		set bounds of devWindow to {0, 0, (item 3 of screenBounds) * 0.75, item 4 of screenBounds}

		-- Redis
		set paneRedis to current session of devWindow
		tell paneRedis
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Redis"
			set name to "Pewcorder · Redis"
			write text "cd " & quoted form of projectRoot
			write text "export PEWCORDER_REDIS_PORT=${PEWCORDER_REDIS_PORT:-6382} PEWCORDER_BACKEND_PORT=${PEWCORDER_BACKEND_PORT:-8005} PEWCORDER_FRONTEND_PORT=${PEWCORDER_FRONTEND_PORT:-5175}"
			write text "source " & quoted form of projectRoot & "/backend/.venv/bin/activate"
			write text "pids=$(lsof -t -iTCP:$PEWCORDER_REDIS_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || { kill $pids 2>/dev/null; sleep 0.5; pids=$(lsof -t -iTCP:$PEWCORDER_REDIS_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || kill -9 $pids 2>/dev/null; }; true"
			write text "redis-server --port $PEWCORDER_REDIS_PORT"
		end tell
		set lastPane to paneRedis

		-- Backend: Django API
		tell lastPane to set paneBackend to (split horizontally with default profile)
		tell paneBackend
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Backend"
			set name to "Pewcorder · Backend"
			write text "cd " & quoted form of (projectRoot & "/backend")
			write text "export PEWCORDER_REDIS_PORT=${PEWCORDER_REDIS_PORT:-6382} PEWCORDER_BACKEND_PORT=${PEWCORDER_BACKEND_PORT:-8005} PEWCORDER_FRONTEND_PORT=${PEWCORDER_FRONTEND_PORT:-5175}"
			write text "source " & quoted form of projectRoot & "/backend/.venv/bin/activate"
			write text "pids=$(lsof -t -iTCP:$PEWCORDER_BACKEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || { kill $pids 2>/dev/null; sleep 0.5; pids=$(lsof -t -iTCP:$PEWCORDER_BACKEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || kill -9 $pids 2>/dev/null; }; true"
			write text "python manage.py runserver 127.0.0.1:$PEWCORDER_BACKEND_PORT"
		end tell
		set lastPane to paneBackend

		-- Celery: Worker and beat, combined for local dev
		tell lastPane to set paneCelery to (split horizontally with default profile)
		tell paneCelery
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Celery"
			set name to "Pewcorder · Celery"
			write text "cd " & quoted form of (projectRoot & "/backend")
			write text "export PEWCORDER_REDIS_PORT=${PEWCORDER_REDIS_PORT:-6382} PEWCORDER_BACKEND_PORT=${PEWCORDER_BACKEND_PORT:-8005} PEWCORDER_FRONTEND_PORT=${PEWCORDER_FRONTEND_PORT:-5175}"
			write text "source " & quoted form of projectRoot & "/backend/.venv/bin/activate"
			write text "printf 'Waiting for Redis on port %s…\\n' $PEWCORDER_REDIS_PORT; until nc -z 127.0.0.1 $PEWCORDER_REDIS_PORT 2>/dev/null; do sleep 0.3; done"
			write text "celery -A config worker --beat --loglevel=INFO"
		end tell
		set lastPane to paneCelery

		-- Frontend: Vite frontend
		tell lastPane to set paneFrontend to (split horizontally with default profile)
		tell paneFrontend
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Frontend"
			set name to "Pewcorder · Frontend"
			write text "cd " & quoted form of (projectRoot & "/frontend")
			write text "export PEWCORDER_REDIS_PORT=${PEWCORDER_REDIS_PORT:-6382} PEWCORDER_BACKEND_PORT=${PEWCORDER_BACKEND_PORT:-8005} PEWCORDER_FRONTEND_PORT=${PEWCORDER_FRONTEND_PORT:-5175}"
			write text "source " & quoted form of projectRoot & "/backend/.venv/bin/activate"
			write text "pids=$(lsof -t -iTCP:$PEWCORDER_FRONTEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || { kill $pids 2>/dev/null; sleep 0.5; pids=$(lsof -t -iTCP:$PEWCORDER_FRONTEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || kill -9 $pids 2>/dev/null; }; true"
			write text "npm run dev -- --port $PEWCORDER_FRONTEND_PORT"
		end tell
		set lastPane to paneFrontend

		-- Working
		tell lastPane to set paneWorking to (split horizontally with default profile)
		tell paneWorking
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Working"
			set name to "Pewcorder · Working"
			write text "cd " & quoted form of projectRoot
			write text "export PEWCORDER_REDIS_PORT=${PEWCORDER_REDIS_PORT:-6382} PEWCORDER_BACKEND_PORT=${PEWCORDER_BACKEND_PORT:-8005} PEWCORDER_FRONTEND_PORT=${PEWCORDER_FRONTEND_PORT:-5175}"
			write text "source " & quoted form of projectRoot & "/backend/.venv/bin/activate"
			write text "git status"
		end tell
		set lastPane to paneWorking
	end tell

	-- Open the app in the default browser once its server answers.
	do shell script "(" & "for i in $(seq 1 240); do nc -z 127.0.0.1 5175 2>/dev/null && break; sleep 0.5; done; " & "open " & quoted form of ("http://localhost:5175" & "/") & ") >/dev/null 2>&1 &"
end run

on iTermInstalled()
	try
		do shell script "open -Ra iTerm"
		return true
	on error
		return false
	end try
end iTermInstalled

-- Runs a command in a login shell at the repo root, so tools on the user's PATH (Homebrew, nvm, uv) are found.
on loginShell(projectRoot, command)
	return do shell script "/bin/zsh -lc " & quoted form of ("cd " & quoted form of projectRoot & " && " & command)
end loginShell
