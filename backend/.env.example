DJANGO_SECRET_KEY=replace-with-at-least-32-random-bytes
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave unset for local SQLite. Production uses DATABASE_URL or DJANGO_DB_*.
# DATABASE_URL=postgres://pewcorder:password@127.0.0.1:5432/pewcorder
# DJANGO_DB_NAME=pewcorder
# DJANGO_DB_USER=pewcorder
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432
# DJANGO_MEDIA_ROOT=/var/www/api.pewcorder.benlocher.com/backend/media
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=com.pewcorder.app
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
SERMON_PROCESSOR=sermons.provider_processor.ProviderSermonProcessor
PUSH_ALERT_SENDER=sermons.push_alerts.LoggingPushAlertSender
PUSH_ALERT_TIMEOUT_SECONDS=15
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY_PATH=
APNS_TOPIC=com.pewcorder.app
APNS_USE_SANDBOX=1
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
CHURCH_SUGGESTION_PROVIDER=sermons.church_suggestions.OverpassChurchSuggestionProvider
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_USER_AGENT="Pewcorder/0.1 (contact: support@pewcorder.app)"
CHURCH_SUGGESTION_TIMEOUT_SECONDS=20
CHURCH_SUGGESTION_LIMIT=5
SERMON_AUDIO_URL_MAX_AGE_SECONDS=14400
PEWCORDER_PUBLIC_WEB_URL=http://127.0.0.1:5173
# Built SPA directory used to inject Open Graph tags into /share/ pages.
# Production default: /var/www/pewcorder.benlocher.com/dist
# PEWCORDER_WEB_DIST_DIR=/var/www/pewcorder.benlocher.com/dist
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL="Pewcorder <share@pewcorder.benlocher.com>"
DJANGO_EMAIL_HOST=smtp.resend.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=resend
DJANGO_EMAIL_HOST_PASSWORD=your_resend_api_key_here
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
# Study artifacts + transcript cleanup still use OpenAI via simpleai.
SIMPLEAI_OPENAI_MODEL=gpt-5.6-sol
SERMON_ARTIFACT_MODEL=openai
SERMON_ARTIFACT_REASONING_LEVEL=high

# Magisterium AI — Related sources (Search) + doctrinal review (Chat).
# Tier examples: free, pro, pay_as_you_go. Leave blank if your key does not need it.
MAGISTERIUM_API_KEY=
MAGISTERIUM_TIER=
# MAGISTERIUM_BASE_URL=https://www.magisterium.com/api/v1
# MAGISTERIUM_TIMEOUT_SECONDS=90

# Voice isolation (ElevenLabs) then diarized transcription (Speechmatics).
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_ISOLATION_TIMEOUT_SECONDS=1800
SERMON_VOICE_ISOLATION_ENABLED=1
SPEECHMATICS_API_KEY=
# Regional Batch host (us1 / eu1 / au1). Bare asr.api.speechmatics.com often 401s.
SPEECHMATICS_API_BASE_URL=https://us1.asr.api.speechmatics.com
SPEECHMATICS_LANGUAGE=en
SPEECHMATICS_MODEL=enhanced
SPEECHMATICS_SPEAKER_SENSITIVITY=0.6
SPEECHMATICS_REQUEST_TIMEOUT_SECONDS=120
SPEECHMATICS_JOB_TIMEOUT_SECONDS=3600
SPEECHMATICS_POLL_INTERVAL_SECONDS=5
SERMON_TRANSCRIBER=sermons.speechmatics_transcriber.SpeechmaticsDiarizedTranscriber

# Legacy OpenAI transcription (set SERMON_TRANSCRIBER to use):
# SERMON_TRANSCRIBER=sermons.openai_transcriber.OpenAIDiarizedTranscriber
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_TRANSCRIPTION_VAD_THRESHOLD=0.1
OPENAI_TRANSCRIPTION_VAD_PREFIX_PADDING_MS=400
OPENAI_TRANSCRIPTION_VAD_SILENCE_DURATION_MS=1000
SERMON_TRANSCRIPTION_CHUNK_SECONDS=600
FFMPEG_BINARY=ffmpeg
